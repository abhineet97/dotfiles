set encoding=utf-8
set nobackup
set nowritebackup
set noswapfile
set history=50
set ruler
set showcmd
set termguicolors
set incsearch
set laststatus=2
set autowrite
set scrolloff=5
set number
set numberwidth=5
set splitbelow
set splitright

syntax on
filetype plugin indent on

" Softtabs, 2 spaces
set tabstop=2
set shiftwidth=2
set shiftround
set expandtab

" Use ripgrep
if executable('rg')
  set grepprg=rg\ --vimgrep\ --no-heading\ --smart-case
endif
